# Copy to .env.local and fill in what you have. Every key is OPTIONAL —
# without it the app falls back to a clearly-labelled demo mode for that
# service (auth/data in localStorage, videos in IndexedDB).

# --- Supabase (auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Not used yet — reserved for a future admin-only route.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (video file storage — S3-compatible) ---
# Access-controlled via app/api/storage/*/route.ts, which verifies a real
# Supabase session before issuing a presigned URL. Without Supabase configured
# too, these are unused (demo mode stores video in IndexedDB instead).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# --- Anthropic (real movement-analysis feedback) ---
# Unused until the pose-analysis follow-up lands. Documented now so enabling
# it later is a one-line change, not a design decision made twice.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
